DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=dms.internal
DJANGO_CSRF_TRUSTED_ORIGINS=https://dms.internal
DJANGO_TIME_ZONE=Africa/Casablanca
INGESTION_STABILITY_SECONDS=5
POSTGRES_DB=dms
POSTGRES_USER=dms_app
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_PASSWORD=replace-with-a-random-redis-password
CELERY_BROKER_URL=redis://:replace-with-a-random-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-a-random-redis-password@redis:6379/1
BACKUP_DESTINATION=/backups
CLAMAV_ENABLED=auto
DJANGO_HSTS_SECONDS=31536000
