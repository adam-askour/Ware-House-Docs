.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
var/*
!var/.gitkeep
!var/protected/
!var/protected/.gitkeep
!var/quarantine/
!var/quarantine/.gitkeep
!var/static/
!var/static/.gitkeep
backups/
*.log

# Locally generated TLS private keys must never be committed.
deploy/certs/*.key
deploy/certs/*.pem
deploy/certs/*.p12
deploy/certs/*.pfx
